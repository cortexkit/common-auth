{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "<spike>/plugin"
  ],
  "providers": {
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:50829/v1"
      },
      "models": {
        "mock-model": {
          "name": "Mock via openai, no configured key"
        }
      }
    },
    "mockcompat": {
      "name": "Generic OpenAI-compatible",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:50829/v1",
        "apiKey": "sk-mock-not-a-real-key"
      },
      "models": {
        "mock-model": {
          "name": "Mock via openai-compatible"
        }
      }
    }
  }
}